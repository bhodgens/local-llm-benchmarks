# /etc/systemd/system/caimlas-nail.service
# 3060 lane (port 8080). 2026-09-20: model swapped Nail-35B -> gemma-4-12B-it-QAT Q4_0
# (queued control row "gemma-4-12B-it-QAT Q4_0 (3060 128K)"). 2026-09-21: swapped BACK to
# Nail-35B at user request (gemma config preserved in deploy/caimlas-nail-gemma.service).
#
# WEDGE HISTORY (Nail-35B config, pre-2026-09-21): 9 systemd restarts. After deploy-day
# config iterations (Sep 14), three CUDA-OOM aborts under load (Sep 20 07:01, 07:04,
# 19:38), all identical: "CUDA error: out of memory" in cudaGraphInstantiate during
# decode, hours after start, following prompt-cache eviction churn. Cause: 262K ctx
# (q8_0 KV, parallel 2) reserves nearly the whole 12 GB card -> any graph re-instantion
# beyond the pool aborts. Restart=on-failure masked it. IF THIS WEDGES AGAIN:
# first fallback --ctx-size 196608, second 131072 (KV q8_0 at parallel 2); the OOM is
# marginal (~hours of churn to trigger), so a ctx reduction should clear it.
[Unit]
Description=Nail-Qwen3.6-35B-A3B-UD-Q4_K_XL Coder/Reviewer default (RTX 3060, llama.cpp upstream, n-cpu-moe=28 partial residency + no-mmap sweep-optimal, parallel=2, kv-unified; restored 2026-09-21 after gemma interim; wedge history documented)
After=network.target

[Service]
Type=simple
Environment=CUDA_VISIBLE_DEVICES=1
ExecStartPre=/bin/sleep 3
ExecStart=/home/caimlas/git/llama.cpp/build/bin/llama-server \
    --model /home/files/llms/Nail-Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf \
    --flash-attn on \
    --gpu-layers 99 \
    --n-cpu-moe 28 \
    --no-mmap \
    --ctx-size 262144 \
    --batch-size 2048 \
    --ubatch-size 512 \
    --threads 6 \
    --threads-batch 6 \
    --cache-type-k q8_0 \
    --cache-type-v q8_0 \
    --reasoning off \
    --host 0.0.0.0 \
    --port 8080 \
    --parallel 2 \
    --cont-batching \
    --kv-unified \
    --temp 0.7 \
    --top-p 0.95 \
    --top-k 20 \
    --repeat-penalty 1.0 \
    -n -1

Restart=on-failure
RestartSec=10
User=caimlas
Group=caimlas
WorkingDirectory=/home/caimlas
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
