# /etc/systemd/system/caimlas-btl4-v100.service
# BTL-4 Q4_K_M (DogukanUrker community build) on the V100 (GPU 0, port 8082).
# Deployed 2026-10-06 as prod coder/reviewer, replacing caimlas-nail-v100 (Nail-35B).
# Rationale: LCB 0.92 / tau2 0.400 at 91.7 t/s (bench lane) vs Nail's 0.92 / 0.20-0.00
# at 31 t/s. Best combined coding+agentic row in the library, 3x throughput.
#
# Serving requirements (from the BTL-4 bench lanes):
#   --jinja + --reasoning off + --reasoning-format deepseek
#   NOTE: deepseek reasoning format -> clients must strip reasoning blocks from
#   old turns. BTL-4 ships 262144 native ctx; served at 131072 for KV headroom
#   (q8_0 KV at 262K + parallel 2 would exceed the 32G card with compute buffers).
#
# VRAM: ~22GB weights + KV; fits V100 32G full offload.
[Unit]
Description=BTL-4 Q4_K_M (DogukanUrker) coder/reviewer (V100, port 8082)
After=network.target

[Service]
Type=simple
Environment=CUDA_VISIBLE_DEVICES=0
ExecStartPre=/bin/sleep 3
ExecStart=/home/caimlas/git/llama.cpp/build/bin/llama-server \
    --model /home/files/llms/dogukanurker-btl4-q4km/BTL-4-Q4_K_M.gguf \
    --flash-attn on \
    --gpu-layers 99 \
    --ctx-size 131072 \
    --batch-size 2048 \
    --ubatch-size 512 \
    --threads 6 \
    --threads-batch 6 \
    --cache-type-k q8_0 \
    --cache-type-v q8_0 \
    --jinja \
    --reasoning off \
    --reasoning-format deepseek \
    --host 0.0.0.0 \
    --port 8082 \
    --parallel 1 \
    --cont-batching \
    --kv-unified \
    --temp 0.7 \
    --top-p 0.95 \
    --top-k 20 \
    --repeat-penalty 1.0 \
    -n -1

Restart=on-failure
RestartSec=10
User=caimlas
Group=caimlas
WorkingDirectory=/home/caimlas
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
