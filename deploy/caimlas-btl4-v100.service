# /etc/systemd/system/caimlas-btl4-v100.service
# BTL-4 Q4_K_M (DogukanUrker community build) on the V100 (GPU 0, port 8082).
# 2026-10-06 v2: 512K shared context (YaRN 2x over 262K native), q4_0 KV, parallel 3.
#
# VRAM budget (V100 32G):
#   weights + compute       ~21.1 GiB
#   KV 524288 tok @ q4_0     ~2.8 GiB  (hybrid arch: only 10/40 layers carry KV)
#   batch growth (3 slots)   ~0.3 GiB
#   LFM2.5-8B co-host 32K    ~6.0 GiB  (caimlas-lfm25-v100.service)
#   total                   ~30.2 / 32 GiB   (TIGHT - watch for cudaMalloc fails)
#
# Context scaling: GGUF declares 262144 native. --rope-scale 2 doubles it to 512K
# (--rope-scaling yarn, --yarn-orig-ctx 262144). Quality past 262K is extrapolated
# - unaudited for this model.
#
# Slots: 3 concurrent sessions share the 524288-token unified pool
# (e.g. 2x256K, 3x174K, 4x131K). Per-session window = pool/parallel.
#
# BTL-4 serving requirements: --jinja --reasoning off --reasoning-format deepseek.
# 2026-10-09: thinking OFF per bench - tau2 halved thinking-on (0.40->0.20), LCB flat.
# (Think-on was tried for meept visibility; reverted on bench evidence.)
[Unit]
Description=BTL-4 Q4_K_M coder (V100, 512K YaRN ctx, q4_0 KV, 3 slots, port 8082)
After=network.target

[Service]
Type=simple
Environment=CUDA_VISIBLE_DEVICES=0
ExecStartPre=/bin/sleep 3
ExecStart=/home/caimlas/git/llama.cpp/build/bin/llama-server \
    --model /home/files/llms/dogukanurker-btl4-q4km/BTL-4-Q4_K_M.gguf \
    --flash-attn on \
    --gpu-layers 99 \
    --ctx-size 524288 \
    --parallel 3 \
    --rope-scale 2 \
    --rope-scaling yarn \
    --yarn-orig-ctx 262144 \
    --batch-size 2048 \
    --ubatch-size 512 \
    --threads 6 \
    --threads-batch 6 \
    --cache-type-k q4_0 \
    --cache-type-v q4_0 \
    --jinja \
    --reasoning off \
    --reasoning-format deepseek \
    --host 0.0.0.0 \
    --port 8082 \
    --cont-batching \
    --kv-unified \
    --temp 0.7 \
    --top-p 0.95 \
    --top-k 20 \
    --repeat-penalty 1.0 \
    --alias btl4 \
    -n -1

Restart=on-failure
RestartSec=10
User=caimlas
Group=caimlas
WorkingDirectory=/home/caimlas
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
